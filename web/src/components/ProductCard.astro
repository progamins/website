---
import { formatEUR, type Producto } from '../lib/db';
interface Props { producto: Producto; }
const { producto } = Astro.props;
const descuento = producto.precio_original && producto.precio_original > producto.precio_actual
  ? Math.round((1 - producto.precio_actual / producto.precio_original) * 100) : null;
const estrellas = Math.round(producto.valoracion);
---
<article class="group overflow-hidden rounded-xl border border-sand-2 bg-surface transition duration-300 hover:-translate-y-1 hover:border-gold/50 hover:shadow-lg hover:shadow-ink/5">
  <a href={`/producto/${producto.slug}`} class="relative block aspect-[4/5] overflow-hidden bg-sand" aria-label={`Ver ${producto.nombre}`}>
    {producto.imagen
      ? <img src={producto.imagen} alt={producto.nombre} loading="lazy" class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.04]" />
      : <div class="flex h-full items-center justify-center text-sm text-ink-soft/60"><span>Sin imagen</span></div>}
    {producto.etiqueta && (
      <span class="absolute left-3 top-3 rounded-full bg-ink-2/85 px-2.5 py-1 text-[10px] font-semibold uppercase tracking-wider text-cream backdrop-blur">{producto.etiqueta}</span>
    )}
    {producto.precio_actual >= 199 && producto.stock > 0 && (
      <span class="absolute bottom-3 left-3 rounded-full bg-ande/95 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-white">Envío gratis</span>
    )}
    {descuento && <span class="absolute right-3 top-3 rounded-full bg-bronce px-2.5 py-1 text-[11px] font-bold text-white">-{descuento}%</span>}
    <span class="pointer-events-none absolute bottom-3 left-1/2 -translate-x-1/2 translate-y-2 rounded-full bg-cream/95 px-4 py-1.5 text-xs font-semibold text-ink-2 opacity-0 shadow-md transition duration-300 group-hover:translate-y-0 group-hover:opacity-100">
      Ver pieza
    </span>
    {producto.stock === 0 && (
      <div class="absolute inset-0 flex items-center justify-center bg-ink/45 backdrop-blur-[1px]">
        <span class="rounded-full bg-ink-2 px-4 py-1.5 text-xs font-bold uppercase tracking-[0.2em] text-cream">Agotado</span>
      </div>
    )}
  </a>
  <div class="p-4">
    <p class="text-[10px] font-semibold uppercase tracking-[0.18em] text-gold-dark">{producto.categoria_nombre ?? 'Joyas'}</p>
    <a href={`/producto/${producto.slug}`} class="mt-1.5 block font-medium leading-snug text-ink transition hover:text-gold-dark">
      {producto.nombre}
    </a>
    {producto.num_valoraciones > 0 && (
      <div class="mt-2 flex items-center gap-1.5" aria-label={`Valoración: ${producto.valoracion.toFixed(1)} de 5 estrellas`}>
        <span class="text-xs tracking-tight text-gold" aria-hidden="true">{'★'.repeat(estrellas)}</span>
        <span class="text-[11px] text-ink-soft/70">({producto.num_valoraciones})</span>
      </div>
    )}
    <div class="mt-2 flex flex-wrap items-baseline gap-2">
      <span class="font-display text-[1.35rem] font-semibold text-ink">{formatEUR(producto.precio_actual)}</span>
      {producto.precio_original && producto.precio_original > producto.precio_actual && (
        <span class="text-sm text-ink-soft/60 line-through">{formatEUR(producto.precio_original)}</span>
      )}
    </div>
  </div>
</article>
