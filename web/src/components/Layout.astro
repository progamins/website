---
import '../styles/global.css';
import Navbar from './Navbar.astro';
import Footer from './Footer.astro';
import CartToast from './CartToast.astro';
interface Props {
  title?: string;
  description?: string;
  image?: string;
}
const { title = 'Chollo & Glam', description = 'Joyería y artesanía peruana de diseño exclusivo', image = '/uploads/colecciones/andes_dorados.jpg' } = Astro.props;
const url = new URL(Astro.request.url);
const can = new URL(Astro.url.pathname + Astro.url.search, Astro.site ?? 'http://localhost:4321').href;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={can} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Chollo & Glam" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, url.origin).href} />
    <meta property="og:url" content={can} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, url.origin).href} />
    <meta name="theme-color" content="#faf6ef" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Jost:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-cream text-ink antialiased">
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />
    <CartToast />
  </body>
</html>