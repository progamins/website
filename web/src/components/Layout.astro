---
import '../styles/global.css';
import Navbar from './Navbar.astro';
import Footer from './Footer.astro';
import CartToast from './CartToast.astro';
import CookieConsent from './CookieConsent.astro';
interface Props {
  title?: string;
  description?: string;
  image?: string;
}
const { title = 'Chollo & Glam', description = 'Joyería y artesanía peruana de diseño exclusivo', image = '/uploads/colecciones/andes_dorados.jpg' } = Astro.props;
const url = new URL(Astro.request.url);
const can = new URL(Astro.url.pathname + Astro.url.search, Astro.site ?? 'http://localhost:4321').href;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={can} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Chollo & Glam" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, url.origin).href} />
    <meta property="og:url" content={can} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, url.origin).href} />
    <meta name="theme-color" content="#faf6ef" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body class="min-h-screen bg-cream text-ink antialiased">
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />
    <CartToast />
    <CookieConsent />

    <!-- WhatsApp comercial: contacto directo, estándar en e-commerce peruano -->
    <a href="https://wa.me/51999999999?text=Hola%20Chollo%20%26%20Glam%20%F0%9F%92%9B%20Quiero%20consultar%20por%20una%20pieza"
       target="_blank" rel="noopener" aria-label="Escríbenos por WhatsApp"
       class="group fixed bottom-5 right-5 z-50 flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] shadow-xl shadow-emerald-600/30 transition hover:scale-110">
      <svg class="h-7 w-7 fill-white" viewBox="0 0 32 32" aria-hidden="true">
        <path d="M16 3C9.4 3 4 8.4 4 15c0 2.1.6 4.2 1.7 6L4 29l8.2-1.6c1.2.6 2.5.9 3.8.9 6.6 0 12-5.4 12-12S22.6 3 16 3zm0 21.8c-1.2 0-2.4-.3-3.5-.8l-.4-.2-4.9 1 1-4.8-.3-.4A9.8 9.8 0 016.2 15c0-5.4 4.4-9.8 9.8-9.8s9.8 4.4 9.8 9.8-4.4 9.8-9.8 9.8zm5.5-7.3c-.3-.2-1.8-.9-2.1-1-.3-.1-.5-.2-.7.2-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.2-1.2-.5-2.3-1.4-.9-.8-1.4-1.7-1.6-2-.2-.3 0-.5.1-.6.1-.1.3-.4.5-.6.2-.2.2-.4.3-.6.1-.2 0-.4 0-.6-.1-.2-.7-1.7-1-2.3-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.6.1-.9.4-.3.3-1.1 1.1-1.1 2.6s1.1 3 1.2 3.2c.2.2 2 3.2 5 4.4 2.5 1 3 .8 3.6.8.5-.1 1.7-.7 1.9-1.4.2-.7.2-1.2.2-1.4-.1-.1-.3-.2-.5-.3z"/>
      </svg>
      <span class="pointer-events-none absolute right-16 whitespace-nowrap rounded-full bg-ink px-4 py-2 text-xs font-semibold text-cream opacity-0 shadow-lg transition group-hover:opacity-100">
        ¿Dudas? Escríbenos
      </span>
    </a>

    <script>
      // Fallback global: si una imagen falla, se sustituye por el placeholder de marca
      document.addEventListener('error', (e) => {
        const t = e.target as HTMLImageElement;
        if (t && t.tagName === 'IMG' && t.getAttribute('src') !== '/assets/placeholder.svg') {
          t.setAttribute('src', '/assets/placeholder.svg');
        }
      }, true);
    </script>
  </body>
</html>