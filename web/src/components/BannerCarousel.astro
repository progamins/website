---
import { getBanners, type Banner } from '../lib/db';
const banners = getBanners();
---
{
  banners.length > 0 && (
    <section data-carousel class="group relative h-[64vh] min-h-[430px] w-full overflow-hidden bg-ink-2 sm:h-[70vh] lg:h-[74vh]" aria-label="Colecciones destacadas" aria-roledescription="carrusel">
      <div data-track class="flex h-full transition-transform duration-700 ease-out">
        {banners.map((b, i) => (
          <div data-slide class="relative h-full w-full shrink-0" aria-hidden={i > 0 ? 'true' : undefined}>
            {b.tipo === 'video' && b.fondo ? (
              <video class="h-full w-full object-cover" autoplay muted loop playsinline preload="metadata">
                <source src={b.fondo} type="video/mp4" />
              </video>
            ) : b.tipo === 'imagen' && b.fondo ? (
              <img src={b.fondo} alt={`Joyería artesanal — colección destacada ${i + 1}`} class="h-full w-full object-cover" loading={i === 0 ? 'eager' : 'lazy'} />
            ) : (
              <div class="h-full w-full bg-gradient-to-br from-ink-3 to-ink-2"></div>
            )}
            {b.enlace && <a href={b.enlace} class="absolute inset-0" aria-label={`Ir a ${b.enlace}`}></a>}
          </div>
        ))}
      </div>

      <!-- Tratamiento editorial: degradado vino y composición inferior izquierda -->
      <div class="pointer-events-none absolute inset-0 z-[5] flex items-end bg-gradient-to-t from-ink-2/90 via-ink-2/30 to-ink/10">
        <div class="mx-auto w-full max-w-7xl px-4 pb-14 sm:px-6 sm:pb-16 lg:pb-20">
          <p class="flex items-center gap-3 text-[11px] font-semibold uppercase tracking-[0.3em] text-gold-light">
            <span class="hidden h-px w-10 bg-gold-light/70 sm:block" aria-hidden="true"></span>
            Joyería y artesanía peruana
          </p>
          <h1 class="mt-4 max-w-2xl font-display text-[2.6rem] leading-[1.05] text-cream sm:text-6xl lg:text-[4.2rem]">
            Piezas únicas, hechas a mano
          </h1>
          <p class="mt-4 max-w-xl text-sm leading-relaxed text-cream/85 sm:text-base">
            Diseños exclusivos en plata, oro y fibras andinas. Envíos a todo el Perú y colecciones de autor inspiradas en nuestros paisajes.
          </p>
          <div class="pointer-events-auto mt-7 flex flex-wrap items-center gap-3">
            <a href="/novedades" class="rounded-full bg-ink-2 px-8 py-3 text-sm font-semibold text-cream shadow-lg shadow-ink/30 ring-1 ring-cream/20 transition hover:bg-vino-dark hover:ring-gold-light/60">
              Descubrir colección
            </a>
            <a href="/ofertas" class="rounded-full border border-cream/45 px-8 py-3 text-sm font-semibold text-cream transition hover:border-cream hover:bg-cream/10">
              Ver ofertas
            </a>
          </div>
        </div>
      </div>

      {banners.length > 1 && (
        <>
          <button data-prev aria-label="Colección anterior"
            class="absolute left-3 top-1/2 z-10 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-cream/10 text-cream opacity-0 backdrop-blur transition hover:bg-cream/25 group-hover:opacity-100 focus-visible:opacity-100">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
          </button>
          <button data-next aria-label="Colección siguiente"
            class="absolute right-3 top-1/2 z-10 flex h-10 w-10 -translate-y-1/2 items-center justify-center rounded-full bg-cream/10 text-cream opacity-0 backdrop-blur transition hover:bg-cream/25 group-hover:opacity-100 focus-visible:opacity-100">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
          </button>
          <div class="absolute bottom-5 right-4 z-10 flex gap-2 sm:right-6" role="tablist" aria-label="Seleccionar colección">
            {banners.map((_, i) => (
              <button data-dot={i} aria-label={`Ir a la colección ${i + 1}`}
                class:list={["h-1 rounded-full transition-all", i === 0 ? "w-8 bg-gold-light" : "w-4 bg-cream/40 hover:bg-cream/70"]}></button>
            ))}
          </div>
        </>
      )}
    </section>
  )
}

<script>
  const root = document.querySelector('[data-carousel]');
  if (root) {
    const track = root.querySelector('[data-track]') as HTMLElement;
    const slides = Array.from(root.querySelectorAll('[data-slide]')) as HTMLElement[];
    const dots = Array.from(root.querySelectorAll('[data-dot]')) as HTMLButtonElement[];
    const prev = root.querySelector('[data-prev]');
    const next = root.querySelector('[data-next]');
    let index = 0;
    let timer: number | undefined;
    const total = slides.length;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (total > 1) {
      const go = (i: number) => {
        index = ((i % total) + total) % total;
        track.style.transform = `translateX(-${index * 100}%)`;
        dots.forEach((d, j) => {
          d.className = j === index ? 'h-1 w-8 rounded-full bg-gold-light transition-all' : 'h-1 w-4 rounded-full bg-cream/40 hover:bg-cream/70 transition-all';
        });
        slides.forEach((s, j) => s.setAttribute('aria-hidden', j === index ? 'false' : 'true'));
      };
      const start = () => { if (!reduced) timer = window.setInterval(() => go(index + 1), 6000); };
      const stop = () => { if (timer) clearInterval(timer); };
      prev?.addEventListener('click', () => { stop(); go(index - 1); start(); });
      next?.addEventListener('click', () => { stop(); go(index + 1); start(); });
      dots.forEach((d, j) => d.addEventListener('click', () => { stop(); go(j); start(); }));
      root.addEventListener('mouseenter', stop);
      root.addEventListener('mouseleave', start);
      root.addEventListener('touchstart', stop, { passive: true });
      start();
    }
  }
</script>
