---
import '../../styles/global.css';
import { countNotificacionesNoLeidas, type Usuario } from '../../lib/db';
interface Props { title?: string; }
const { title = 'Panel de Administración' } = Astro.props;
const user = Astro.locals.user as Usuario;
const noLeidas = countNotificacionesNoLeidas();
const path = Astro.url.pathname;
const items = [
  { href: '/admin', label: 'Dashboard', icon: 'M3 12l9-9 9 9M5 10v10h14V10' },
  { href: '/admin/productos', label: 'Productos', icon: 'M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4' },
  { href: '/admin/categorias', label: 'Categorías', icon: 'M4 6h16M4 12h16M4 18h10' },
  { href: '/admin/colecciones', label: 'Colecciones', icon: 'M4 6h16M4 12h16M4 18h10' },
  { href: '/admin/ofertas', label: 'Ofertas Flash', icon: 'M13 10V3L4 14h7v7l9-11h-7z' },
  { href: '/admin/pedidos', label: 'Pedidos', icon: 'M3 3h18l-1 17-8 2-8-2L3 3zm4 4h10M7 11h10' },
  { href: '/admin/pagos', label: 'Pagos', icon: 'M3 10h18M3 14h18M6 6h12M6 18h12' },
  { href: '/admin/moderacion', label: 'Moderación', icon: 'M9 12l2 2 4-4M12 3l1.5 1.5L15 3l.9 1.9L18 4l-.3 2.1L21 7l-1.9 2.1L21 11l-2 2.4M4 21v-7' },
  { href: '/admin/usuarios', label: 'Usuarios', icon: 'M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z' },
  { href: '/admin/mensajes', label: 'Mensajes', icon: 'M21 12a8 8 0 01-8 8H4l2-2a8 8 0 1115-6z' },
  { href: '/admin/configuracion', label: 'Configuración', icon: 'M12 15a3 3 0 100-6 3 3 0 000 6zM19.4 15a1.7 1.7 0 00.3 1.9l.1.1a2 2 0 11-2.8 2.8l-.1-.1a1.7 1.7 0 00-1.9-.3 1.7 1.7 0 00-1 1.5V21a2 2 0 11-4 0v-.2a1.7 1.7 0 00-1-1.5 1.7 1.7 0 00-1.9.3l-.1.1a2 2 0 11-2.8-2.8l.1-.1a1.7 1.7 0 00.3-1.9 1.7 1.7 0 00-1.5-1H3a2 2 0 110-4h.2a1.7 1.7 0 001.5-1 1.7 1.7 0 00-.3-1.9l-.1-.1a2 2 0 112.8-2.8l.1.1a1.7 1.7 0 001.9.3h.1a1.7 1.7 0 001-1.5V3a2 2 0 114 0v.2a1.7 1.7 0 001 1.5h.1a1.7 1.7 0 001.9-.3l.1-.1a2 2 0 112.8 2.8l-.1.1a1.7 1.7 0 00-.3 1.9v.1a1.7 1.7 0 001.5 1h.2a2 2 0 110 4h-.2a1.7 1.7 0 00-1.5 1z' },
];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;0,700;1,500&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <title>{title}</title>
  </head>
  <body class="bg-ink text-gray-200 antialiased">
    <div class="flex min-h-screen">
      <aside class="hidden w-64 shrink-0 flex-col border-r border-white/10 bg-ink-2 lg:flex">
        <a href="/" class="flex items-center gap-2 border-b border-white/10 p-5">
          <span class="flex h-8 w-8 items-center justify-center rounded-full bg-gold font-display font-bold text-ink">C</span>
          <div>
            <span class="block font-display text-white">Chollo <span class="text-gold">&amp;</span> Glam</span>
            <span class="text-[10px] uppercase tracking-widest text-gold">Admin</span>
          </div>
        </a>
        <nav class="flex-1 space-y-1 p-3">
          {items.map((it) => (
            <a href={it.href} class:list={["flex items-center gap-3 rounded-xl px-4 py-2.5 text-sm font-medium transition", path === it.href ? "bg-gold text-ink" : "text-gray-300 hover:bg-white/5 hover:text-gold"]}>
              <svg class="h-4 w-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d={it.icon}/></svg>
              {it.label}
              {it.href === '/admin/moderacion' && <span data-notif-badge class="ml-auto rounded-full bg-red-500 px-2 text-[10px] font-bold text-white">{noLeidas}</span>}
            </a>
          ))}
        </nav>
        <div class="border-t border-white/10 p-4">
          <div class="flex items-center gap-3">
            <div class="flex h-9 w-9 items-center justify-center rounded-full bg-gold/20 text-gold">{user.nombre.charAt(0)}</div>
            <div class="min-w-0">
              <p class="truncate text-sm font-medium text-white">{user.nombre}</p>
              <p class="text-xs capitalize text-gray-400">{user.rol}</p>
            </div>
          </div>
          <div class="mt-3 flex gap-2">
            <a href="/" class="flex-1 rounded-full border border-white/15 py-1.5 text-center text-xs text-gray-300 hover:border-gold hover:text-gold">Ver tienda</a>
            <form action="/api/auth/admin-logout" method="post"><button class="flex-1 rounded-full border border-white/15 py-1.5 text-xs text-gray-300 hover:border-red-400 hover:text-red-400">Salir</button></form>
          </div>
        </div>
      </aside>

      <div class="flex min-w-0 flex-1 flex-col">
        <header class="sticky top-0 z-30 flex h-16 items-center justify-between border-b border-white/10 bg-ink/90 px-4 backdrop-blur sm:px-6">
          <div class="lg:hidden font-display text-white">Chollo &amp; Glam</div>
          <h1 class="hidden font-display text-lg text-white lg:block">{title}</h1>
          <div class="flex items-center gap-4">
            <a href="/admin/notificaciones" class="relative text-gray-300 hover:text-gold">
              <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.4-1.4A2 2 0 0118 14.2V11a6 6 0 10-12 0v3.2a2 2 0 01-.6 1.4L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
              <span class="absolute -right-1.5 -top-1.5 flex h-4 min-w-4 items-center justify-center rounded-full bg-gold px-1 text-[10px] font-bold text-ink">{noLeidas}</span>
            </a>
          </div>
        </header>
        <main class="flex-1 p-4 sm:p-6">
          <slot />
        </main>
      </div>
    </div>

    <!-- Navegación móvil inferior -->
    <nav class="fixed bottom-0 left-0 right-0 z-40 flex justify-around border-t border-white/10 bg-ink-2 p-2 lg:hidden">
      {items.slice(0, 6).map((it) => (
        <a href={it.href} class:list={["rounded-lg p-2", path === it.href ? "text-gold" : "text-gray-400"]}>
          <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d={it.icon}/></svg>
        </a>
      ))}
    </nav>
  
<script>
  // ================================================================
  // CG AdminUI — modales y toasts de producción (sin dependencias)
  // ================================================================
  interface CgToastOpts { title?: string; message?: string; tone?: string; duration?: number; }
  interface CgConfirmOpts { title?: string; message?: string; confirmText?: string; cancelText?: string; tone?: string; }
  declare global {
    interface Window {
      cgToast?: (opts: string | CgToastOpts) => () => void;
      cgConfirm?: (opts: CgConfirmOpts) => Promise<boolean>;
    }
  }
  (function () {
    'use strict';

    // ---------- Toasts apilados ----------
    let toastWrap: HTMLDivElement | null = null;
    function getWrap() {
      if (!toastWrap) {
        toastWrap = document.createElement('div');
        toastWrap.className = 'fixed right-4 top-4 z-[999] flex w-80 flex-col gap-2';
        document.body.appendChild(toastWrap);
      }
      return toastWrap;
    }
    const TONES: Record<string, { icon: string; bg: string; color: string; bar: string; ring: string }> = {
      success: { icon: '✓', bg: 'bg-emerald-500/15', color: 'text-emerald-300', bar: 'bg-emerald-400', ring: 'ring-emerald-400/30' },
      error:   { icon: '✕', bg: 'bg-red-500/15',      color: 'text-red-300',      bar: 'bg-red-400',      ring: 'ring-red-400/30' },
      info:    { icon: '◆', bg: 'bg-gold/15',         color: 'text-gold-light',   bar: 'bg-gold',         ring: 'ring-gold/30' },
    };
    window.cgToast = function (opts: string | CgToastOpts) {
      const o: CgToastOpts = typeof opts === 'string' ? { message: opts } : (opts || {});
      const t = TONES[o.tone || 'info'] || TONES.info;
      const dur = o.duration || 3800;
      const el = document.createElement('div');
      el.className = 'pointer-events-auto relative overflow-hidden rounded-2xl border border-white/10 bg-ink-2/95 p-4 pr-10 shadow-2xl ring-1 ' + t.ring + ' cg-toast-in';
      el.innerHTML =
        '<div class="flex items-start gap-3">' +
          '<span class="mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full ' + t.bg + ' ' + t.color + ' text-sm font-bold">' + t.icon + '</span>' +
          '<div class="min-w-0">' +
            (o.title ? '<p class="text-sm font-semibold text-white">' + o.title + '</p>' : '') +
            (o.message ? '<p class="mt-0.5 text-xs leading-relaxed text-gray-400">' + o.message + '</p>' : '') +
          '</div>' +
          '<button aria-label="Cerrar" class="absolute right-2.5 top-2 text-xl leading-none text-gray-500 transition hover:text-white">×</button>' +
        '</div>' +
        '<span class="absolute bottom-0 left-0 h-0.5 ' + t.bar + '" style="animation: cgBar ' + dur + 'ms linear forwards"></span>';
      getWrap().appendChild(el);
      const close = () => { el.classList.add('cg-toast-out'); setTimeout(() => el.remove(), 220); };
      el.querySelector('button')!.onclick = close;
      setTimeout(close, dur);
      return close;
    };

    // ---------- Modal de confirmación (Promise) ----------
    let modalAbierto = false;
    window.cgConfirm = function (opts?: CgConfirmOpts) {
      const o: CgConfirmOpts = opts || {};
      return new Promise<boolean>((resolve) => {
        if (modalAbierto) return resolve(false);
        modalAbierto = true;
        const map: Record<string, { icon: string; bg: string; color: string; btn: string; ring: string }> = {
          danger:  { icon: '!', bg: 'bg-red-500/15',     color: 'text-red-300',    btn: 'bg-red-500 hover:bg-red-600',    ring: 'ring-red-400/30' },
          warning: { icon: '?', bg: 'bg-gold/15',        color: 'text-gold-light', btn: 'bg-gold hover:bg-gold-dark',    ring: 'ring-gold/30' },
          success: { icon: '✓', bg: 'bg-emerald-500/15',  color: 'text-emerald-300', btn: 'bg-emerald-500 hover:bg-emerald-600', ring: 'ring-emerald-400/30' },
        };
        const t = map[o.tone || 'danger'] || map.danger;
        const back = document.createElement('div');
        back.className = 'fixed inset-0 z-[1000] flex items-center justify-center bg-ink/80 p-4 backdrop-blur-sm cg-fade-in';
        back.innerHTML =
          '<div role="dialog" aria-modal="true" class="w-full max-w-md rounded-2xl border border-white/10 bg-ink-2 p-6 shadow-2xl ring-1 ' + t.ring + ' cg-modal-in">' +
            '<div class="flex items-start gap-4">' +
              '<span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full ' + t.bg + ' ' + t.color + ' text-xl font-bold">' + t.icon + '</span>' +
              '<div class="min-w-0">' +
                '<h3 class="font-display text-lg leading-snug text-white">' + (o.title || '¿Confirmar acción?') + '</h3>' +
                (o.message ? '<p class="mt-1.5 text-sm leading-relaxed text-gray-400">' + o.message + '</p>' : '') +
              '</div>' +
            '</div>' +
            '<div class="mt-6 flex justify-end gap-2.5">' +
              '<button data-no class="rounded-full border border-white/15 px-5 py-2.5 text-sm font-medium text-gray-300 transition hover:border-white/40 hover:text-white">' + (o.cancelText || 'Cancelar') + '</button>' +
              '<button data-yes class="rounded-full px-5 py-2.5 text-sm font-semibold text-white shadow-lg transition hover:-translate-y-0.5 ' + t.btn + '">' + (o.confirmText || 'Confirmar') + '</button>' +
            '</div>' +
          '</div>';
        const fin = (ok: boolean) => {
          modalAbierto = false;
          back.classList.add('cg-fade-out');
          setTimeout(() => back.remove(), 160);
          resolve(ok);
        };
        back.querySelector<HTMLElement>('[data-yes]')!.onclick = () => fin(true);
        back.querySelector<HTMLElement>('[data-no]')!.onclick = () => fin(false);
        back.addEventListener('click', (e) => { if (e.target === back) fin(false); });
        const onKey = (e: KeyboardEvent) => { if (e.key === 'Escape') { document.removeEventListener('keydown', onKey); fin(false); } };
        document.addEventListener('keydown', onKey);
        document.body.appendChild(back);
        back.querySelector<HTMLElement>('[data-no]')!.focus();
      });
    };

    // ---------- Interceptación: formularios con data-confirm ----------
    document.addEventListener('submit', (e) => {
      const form = e.target;
      if (!(form instanceof HTMLFormElement) || !form.dataset.confirm) return;
      if (form.dataset.cgConfirmed === '1') { delete form.dataset.cgConfirmed; return; }
      e.preventDefault();
      window.cgConfirm!({
        title: form.dataset.confirmTitle,
        message: form.dataset.confirm,
        confirmText: form.dataset.confirmText,
        tone: form.dataset.confirmTone || 'danger',
      }).then((ok: boolean) => {
        if (!ok) return;
        form.dataset.cgConfirmed = '1';
        form.requestSubmit();
      });
    }, true);

    // ---------- Estados de carga (anti doble-submit) ----------
    document.addEventListener('submit', (e) => {
      const form = e.target;
      if (!(form instanceof HTMLFormElement)) return;
      const esConfirmPendiente = form.dataset.confirm && form.dataset.cgConfirmed !== '1';
      if (esConfirmPendiente) return;
      setTimeout(() => {
        form.querySelectorAll('button').forEach((b) => {
          if (b.type !== 'submit' && !form.checkValidity) return;
          if (b.hasAttribute('data-yes') || b.hasAttribute('data-no')) return;
          b.disabled = true;
          b.dataset.cgLabel = b.innerHTML;
          b.style.minWidth = Math.max(b.offsetWidth, 44) + 'px';
          b.innerHTML = '<span class="inline-block h-4 w-4 animate-spin rounded-full border-2 border-white/30 border-t-white align-middle"></span>';
        });
      }, 0);
    });

    // ---------- Flash: ?ok= / ?error= → toast elegante + URL limpia ----------
    try {
      const params = new URLSearchParams(location.search);
      const ok = params.get('ok');
      const err = params.get('error');
      if (ok) { window.cgToast?.({ title: 'Acción completada', message: ok, tone: 'success' }); params.delete('ok'); }
      if (err) { window.cgToast?.({ title: 'Ha ocurrido un problema', message: err, tone: 'error', duration: 6000 }); params.delete('error'); }
      if (ok || err) {
        const qs = params.toString();
        history.replaceState({}, '', location.pathname + (qs ? '?' + qs : ''));
      }
    } catch (_) {}
  })();
</script>

<style is:global>
  @keyframes cgBar { from { width: 100%; } to { width: 0%; } }
  .cg-toast-in { animation: cgToastIn 0.25s cubic-bezier(.16,1,.3,1) both; }
  @keyframes cgToastIn { from { opacity: 0; transform: translateX(24px); } to { opacity: 1; transform: none; } }
  .cg-toast-out { opacity: 0; transform: translateX(24px); transition: all 0.2s; }
  .cg-fade-in { animation: cgFadeIn 0.18s ease both; }
  @keyframes cgFadeIn { from { opacity: 0; } to { opacity: 1; } }
  .cg-fade-out { opacity: 0 !important; transition: opacity 0.15s; }
  .cg-modal-in { animation: cgModalIn 0.22s cubic-bezier(.16,1,.3,1) both; }
  @keyframes cgModalIn { from { opacity: 0; transform: translateY(14px) scale(.97); } to { opacity: 1; transform: none; } }
</style>

</body>
</html>

<script>
  window.addEventListener('cg:notif', () => {
    document.querySelectorAll('[data-notif-badge]').forEach((b) => {
      fetch('/api/notificaciones/count').then((r) => r.json()).then((d) => {
        b.textContent = String(d.n);
        b.classList.toggle('hidden', d.n === 0);
      });
    });
  });
</script>