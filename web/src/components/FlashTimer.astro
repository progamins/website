---
interface Props { fin: string; }
const { fin } = Astro.props;
const finIso = new Date(fin + 'Z').toISOString();
const finalizada = new Date(finIso).getTime() <= Date.now();
---
<div class="flex items-center gap-2" data-timer data-fin={finIso}>
  {finalizada ? (
    <p class="rounded-full bg-white/10 px-4 py-1.5 text-sm font-medium text-cream/80">La oferta ha finalizado</p>
  ) : (
    <>
      <span class="flex min-w-[3.4rem] flex-col items-center rounded-lg border border-white/10 bg-white/10 px-2 py-1.5">
        <span class="font-display text-xl leading-none text-gold-light" data-d>0</span><span class="mt-0.5 text-[10px] uppercase tracking-wider text-cream/60">días</span>
      </span>
      <span class="text-gold-light/60" aria-hidden="true">:</span>
      <span class="flex min-w-[3.4rem] flex-col items-center rounded-lg border border-white/10 bg-white/10 px-2 py-1.5">
        <span class="font-display text-xl leading-none text-gold-light" data-h>0</span><span class="mt-0.5 text-[10px] uppercase tracking-wider text-cream/60">horas</span>
      </span>
      <span class="text-gold-light/60" aria-hidden="true">:</span>
      <span class="flex min-w-[3.4rem] flex-col items-center rounded-lg border border-white/10 bg-white/10 px-2 py-1.5">
        <span class="font-display text-xl leading-none text-gold-light" data-m>0</span><span class="mt-0.5 text-[10px] uppercase tracking-wider text-cream/60">min</span>
      </span>
      <span class="text-gold-light/60" aria-hidden="true">:</span>
      <span class="flex min-w-[3.4rem] flex-col items-center rounded-lg border border-white/10 bg-white/10 px-2 py-1.5">
        <span class="font-display text-xl leading-none text-gold-light" data-s>0</span><span class="mt-0.5 text-[10px] uppercase tracking-wider text-cream/60">seg</span>
      </span>
    </>
  )}
</div>

<script>
  const el = document.querySelector<HTMLElement>('[data-timer]');
  if (el) {
    const fin = new Date(el.dataset.fin!).getTime();
    if (fin <= Date.now()) {
      el.innerHTML = '<p class="rounded-full bg-white/10 px-4 py-1.5 text-sm font-medium text-cream/80">La oferta ha finalizado</p>';
    } else {
      const d = el.querySelector('[data-d]')!, h = el.querySelector('[data-h]')!,
            m = el.querySelector('[data-m]')!, s = el.querySelector('[data-s]')!;
      const pad = (n: number) => String(n).padStart(2, '0');
      let interval: number | undefined;
      const mostrarFin = () => {
        if (interval) clearInterval(interval);
        el.innerHTML = '<p class="rounded-full bg-white/10 px-4 py-1.5 text-sm font-medium text-cream/80">La oferta ha finalizado</p>';
      };
      const tick = () => {
        const diff = fin - Date.now();
        if (diff <= 0) { mostrarFin(); return; }
        d.textContent = String(Math.floor(diff / 86400000));
        h.textContent = pad(Math.floor(diff / 3600000) % 24);
        m.textContent = pad(Math.floor(diff / 60000) % 60);
        s.textContent = pad(Math.floor(diff / 1000) % 60);
      };
      tick();
      interval = window.setInterval(tick, 1000);
    }
  }
</script>
