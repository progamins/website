---
/**
 * TrustBar — franja de beneficios verificables.
 * Los métodos de pago coinciden con los disponibles en el checkout
 * (tarjeta, PayPal, transferencia). El umbral de envío gratis (S/ 199)
 * es el mismo que aplica la lógica de producto.
 */
const usps = [
  {
    titulo: 'Envío gratis',
    sub: 'Desde S/ 199 a todo el Perú',
    icono: `<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M9 17a2 2 0 100 4 2 2 0 000-4zM19 17a2 2 0 100 4 2 2 0 000-4zM13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1h4m0 0h3m-16 0a2 2 0 104 0m-4 0a2 2 0 114 0m10 0a2 2 0 104 0m-4 0a2 2 0 114 0m-8-11h4l3 5m-7-5v5H6"/></svg>`,
  },
  {
    titulo: 'Pago seguro',
    sub: 'Tarjeta · PayPal · Transferencia',
    icono: `<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>`,
  },
  {
    titulo: 'Hecho a mano',
    sub: 'Artesanía peruana pieza por pieza',
    icono: `<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M7 11.5V14m0-2.5v-6a1.5 1.5 0 113 0m-3 6a1.5 1.5 0 00-3 0v6a3 3 0 003 3h7.5a3 3 0 003-3v-2m0 0a1.5 1.5 0 01-1.5-1.5v-1.5a1.5 1.5 0 013 0V14m-3 0h-3m-1-5.5v-6a1.5 1.5 0 013 0v6m-9 0v-4a1.5 1.5 0 013 0v4"/></svg>`,
  },
  {
    titulo: 'Cambios tranquilos',
    sub: '30 días para decidir con calma',
    icono: `<svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0A8.003 8.003 0 0112 4a8.003 8.003 0 017.938 5M20 20v-5h-.582m0 0a8.003 8.003 0 01-7.938 5 8.003 8.003 0 01-7.418-5m15.356 0A8 8 0 004.582 9"/></svg>`,
  },
];
---

<section aria-label="Beneficios de comprar en Chollo & Glam" class="border-b border-sand-2 bg-cream">
  <div class="mx-auto grid max-w-7xl grid-cols-2 gap-x-6 gap-y-5 px-4 py-8 sm:px-6 lg:grid-cols-4">
    {usps.map((u) => (
      <div class="flex items-center gap-3.5">
        <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-gold/30 bg-sand/60 text-gold-dark" set:html={u.icono} />
        <div class="min-w-0">
          <p class="truncate text-sm font-semibold text-ink">{u.titulo}</p>
          <p class="truncate text-xs text-ink-soft">{u.sub}</p>
        </div>
      </div>
    ))}
  </div>
</section>
