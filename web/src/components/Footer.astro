---
import { getLogo } from '../lib/db';
const year = new Date().getFullYear();
const logo = getLogo();
const enlaces = [
  { label: 'Collares', href: '/categoria/collares' },
  { label: 'Aretes', href: '/categoria/aretes' },
  { label: 'Anillos', href: '/categoria/anillos' },
  { label: 'Pulseras', href: '/categoria/pulseras' },
  { label: 'Relojes', href: '/categoria/relojes' },
  { label: 'Accesorios', href: '/categoria/accesorios' },
  { label: 'Bolsos y Carteras', href: '/categoria/bolsos' },
  { label: 'Novedades', href: '/novedades' },
  { label: 'Ofertas', href: '/ofertas' },
];
const ayuda = [
  { label: 'Cómo comprar', href: '/contacto' },
  { label: 'Envíos y entregas', href: '/contacto' },
  { label: 'Cambios y devoluciones', href: '/contacto' },
  { label: 'Preguntas frecuentes', href: '/contacto' },
  { label: 'Contacto', href: '/contacto' },
];
// Métodos de pago reales disponibles en el checkout
const pagos = ['Visa', 'Mastercard', 'PayPal', 'Transferencia'];
---
<footer class="relative mt-20">
  <div class="h-px w-full bg-gradient-to-r from-gold-dark/0 via-gold to-gold-dark/0"></div>
  <div class="bg-ink-2 text-cream/80">
    <!-- CTA newsletter -->
    <div class="relative overflow-hidden border-b border-white/10">
      <div class="absolute -right-16 -top-16 h-56 w-56 rounded-full bg-gold/10 blur-3xl" aria-hidden="true"></div>
      <div class="relative mx-auto flex max-w-7xl flex-col items-center justify-between gap-6 px-4 py-12 sm:px-6 lg:flex-row">
        <div class="text-center lg:text-left">
          <p class="text-[11px] font-semibold uppercase tracking-[0.25em] text-gold-light">Círculo Chollo & Glam</p>
          <h3 class="mt-2 font-display text-3xl text-cream">Únete a nuestro círculo</h3>
          <p class="mt-1.5 text-sm text-cream/60">Novedades, lanzamientos y descuentos antes que nadie.</p>
        </div>
        <div class="w-full max-w-md">
          <form class="flex gap-2" data-newsletter novalidate>
            <label for="newsletter-email" class="sr-only">Correo electrónico</label>
            <input id="newsletter-email" name="email" type="email" required placeholder="tu@email.com" autocomplete="email"
              class="w-full rounded-full border border-white/15 bg-white/5 px-5 py-3 text-sm text-cream placeholder-cream/40 outline-none transition focus:border-gold-light focus-visible:outline-none" />
            <button data-newsletter-btn class="shrink-0 rounded-full bg-gold px-6 py-3 text-sm font-semibold text-ink transition hover:bg-gold-light disabled:cursor-not-allowed disabled:opacity-60">Suscribirme</button>
          </form>
          <p class="mt-2.5 hidden text-sm" data-newsletter-msg role="status" aria-live="polite"></p>
        </div>
      </div>
    </div>

    <!-- Columnas -->
    <div class="mx-auto grid max-w-7xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-2 lg:grid-cols-4">
      <div>
        <a href="/" class="flex items-center gap-2.5">
          {logo ? (
            <img src={logo} alt="Chollo & Glam" class="h-10 w-auto max-w-[10rem] object-contain" />
          ) : (
            <>
              <span class="flex h-10 w-10 items-center justify-center rounded-full bg-gold/15 font-display text-lg font-semibold text-gold-light ring-1 ring-gold/40">C</span>
              <span class="font-display text-2xl text-cream">Chollo <span class="text-gold-light">&</span> Glam</span>
            </>
          )}
        </a>
        <p class="mt-4 text-sm leading-relaxed text-cream/60">Joyería y artesanía peruana de diseño exclusivo. Piezas hechas a mano que cuentan historias andinas, para ti.</p>
        <div class="mt-5 flex gap-3">
          <a href="https://www.instagram.com/cholloyglam" target="_blank" rel="noopener" class="flex h-10 w-10 items-center justify-center rounded-full border border-white/15 text-cream/70 transition hover:border-gold-light hover:bg-gold/10 hover:text-gold-light" aria-label="Instagram de Chollo & Glam (@cholloyglam)">
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.2c3.2 0 3.6 0 4.9.07 1.2.05 1.8.25 2.2.42.6.22 1 .48 1.4.9.4.4.7.8.9 1.4.17.4.37 1 .42 2.2.06 1.3.07 1.7.07 4.9s0 3.6-.07 4.9c-.05 1.2-.25 1.8-.42 2.2-.22.6-.48 1-.9 1.4-.4.4-.8.7-1.4.9-.4.17-1 .37-2.2.42-1.3.06-1.7.07-4.9.07s-3.6 0-4.9-.07c-1.2-.05-1.8-.25-2.2-.42a3.8 3.8 0 01-1.4-.9 3.8 3.8 0 01-.9-1.4c-.17-.4-.37-1-.42-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.07-4.9c.05-1.2.25-1.8.42-2.2.22-.6.48-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.17 1-.37 2.2-.42C8.4 2.2 8.8 2.2 12 2.2zm0 1.8c-3.1 0-3.5 0-4.8.07-1.1.05-1.7.24-2.1.4-.5.19-.9.42-1.3.8-.4.4-.6.8-.8 1.3-.16.4-.35 1-.4 2.1C2.4 8.5 2.4 8.9 2.4 12s0 3.5.07 4.8c.05 1.1.24 1.7.4 2.1.19.5.42.9.8 1.3.4.4.8.6 1.3.8.4.16 1 .35 2.1.4 1.3.06 1.7.07 4.8.07s3.5 0 4.8-.07c1.1-.05 1.7-.24 2.1-.4.5-.19.9-.42 1.3-.8.4-.4.6-.8.8-1.3.16-.4.35-1 .4-2.1.06-1.3.07-1.7.07-4.8s0-3.5-.07-4.8c-.05-1.1-.24-1.7-.4-2.1a3.5 3.5 0 00-.8-1.3 3.5 3.5 0 00-1.3-.8c-.4-.16-1-.35-2.1-.4C15.5 4 15.1 4 12 4zm0 3.1a4.9 4.9 0 110 9.8 4.9 4.9 0 010-9.8zm0 1.8a3.1 3.1 0 100 6.2 3.1 3.1 0 000-6.2zm5.1-2.9a1.1 1.1 0 110 2.2 1.1 1.1 0 010-2.2z"/></svg>
          </a>
        </div>
      </div>

      <div>
        <h4 class="text-xs font-semibold uppercase tracking-[0.2em] text-gold-light">Tienda</h4>
        <ul class="mt-5 space-y-2.5 text-sm">
          {enlaces.map((l) => (
            <li><a href={l.href} class="text-cream/60 transition hover:text-gold-light">{l.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="text-xs font-semibold uppercase tracking-[0.2em] text-gold-light">Ayuda</h4>
        <ul class="mt-5 space-y-2.5 text-sm">
          {ayuda.map((l) => (
            <li><a href={l.href} class="text-cream/60 transition hover:text-gold-light">{l.label}</a></li>
          ))}
        </ul>
      </div>

      <div>
        <h4 class="text-xs font-semibold uppercase tracking-[0.2em] text-gold-light">Contacto</h4>
        <ul class="mt-5 space-y-3 text-sm text-cream/60">
          <li>
            <a href="mailto:clientes@cholloyglam.com" class="flex items-start gap-3 transition hover:text-gold-light">
              <svg class="mt-0.5 h-4 w-4 shrink-0 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.5 5.5a2.4 2.4 0 003 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
              clientes@cholloyglam.com
            </a>
          </li>
          <li class="flex items-start gap-3">
            <svg class="mt-0.5 h-4 w-4 shrink-0 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21s-7-5-7-11a7 7 0 0114 0c0 6-7 11-7 11z"/><path stroke-linecap="round" stroke-linejoin="round" d="M12 12a2 2 0 100-4 2 2 0 000 4z"/></svg>
            Perú
          </li>
        </ul>
      </div>
    </div>

    <!-- Métodos de pago (los mismos disponibles en el checkout) -->
    <div class="border-t border-white/10">
      <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-4 px-4 py-6 sm:px-6">
        <p class="text-xs uppercase tracking-[0.15em] text-cream/50">Métodos de pago</p>
        <div class="flex flex-wrap gap-2">
          {pagos.map((p) => (
            <span class="rounded-lg border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-semibold tracking-wide text-cream/80">{p}</span>
          ))}
        </div>
      </div>
    </div>

    <!-- Barra inferior -->
    <div class="border-t border-white/10">
      <div class="mx-auto flex max-w-7xl flex-col items-center justify-between gap-3 px-4 py-6 text-xs text-cream/50 sm:flex-row sm:px-6">
        <p>© {year} Chollo & Glam · Hecho con <span class="text-gold-light">♥</span> en Perú. Todos los derechos reservados.</p>
        <div class="flex gap-6">
          <a href="/terminos" class="transition hover:text-gold-light">Términos</a>
          <a href="/privacidad" class="transition hover:text-gold-light">Privacidad</a>
          <a href="/cookies" class="transition hover:text-gold-light">Cookies</a>
        </div>
      </div>
    </div>
  </div>
</footer>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-newsletter]').forEach((form) => {
    const btn = form.querySelector('[data-newsletter-btn]') as HTMLButtonElement;
    const input = form.querySelector('[name=email]') as HTMLInputElement;
    const msg = (form.parentElement?.querySelector('[data-newsletter-msg]') ?? form.nextElementSibling) as HTMLElement;
    if (!msg || !input) return;
    const mostrar = (texto: string, ok: boolean) => {
      msg.textContent = texto;
      msg.classList.remove('hidden', 'text-ande', 'text-red-300');
      msg.classList.add(ok ? 'text-ande' : 'text-red-300');
    };
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      // Validación nativa + mensaje comprensible
      if (!input.checkValidity()) {
        mostrar('Introduce un correo electrónico válido.', false);
        input.focus();
        return;
      }
      btn.disabled = true;
      btn.textContent = 'Enviando…';
      try {
        const res = await fetch('/api/suscribir', {
          method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ email: input.value }),
        });
        const data = await res.json();
        if (data.ok) {
          mostrar('¡Gracias por suscribirte! Te avisaremos de cada novedad.', true);
          form.reset();
        } else {
          mostrar('Ese correo ya está suscrito o no es válido.', false);
        }
      } catch {
        mostrar('No pudimos completar la suscripción. Inténtalo de nuevo en un momento.', false);
      } finally {
        btn.disabled = false;
        btn.textContent = 'Suscribirme';
      }
    });
  });
</script>
