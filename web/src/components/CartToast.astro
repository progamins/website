---
const fmt = (n: number) => new Intl.NumberFormat('es-PE', { style: 'currency', currency: 'PEN' }).format(n);
---
<div data-toast-root class="pointer-events-none fixed bottom-5 right-5 z-[100] flex w-full max-w-sm flex-col items-end gap-2 px-4 sm:px-0"></div>

<script>
  const fmt = (n: number) => new Intl.NumberFormat('es-PE', { style: 'currency', currency: 'PEN' }).format(n);
  const root = document.querySelector('[data-toast-root]');
  let timer: number | undefined;

  window.addEventListener('cg:toast', ((e: CustomEvent) => {
    if (!root) return;
    const d = e.detail ?? {};
    const nombre = d.nombre || 'Producto';
    const imagen = d.imagen || '';
    const precio = Number(d.precio) || 0;
    const cant = Number(d.cantidad) || 1;

    const el = document.createElement('div');
    el.className = 'toast-in pointer-events-auto flex items-center gap-3 rounded-2xl border border-ink/10 bg-surface p-3 shadow-xl shadow-ink/15';
    el.innerHTML = `
      <div class="check-anim relative flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-ande/10">
        <svg class="h-6 w-6 text-ande" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 13l4 4L19 7"/>
        </svg>
      </div>
      ${imagen ? `<img src="${imagen}" class="h-12 w-12 shrink-0 rounded-lg object-cover bg-sand" onerror="this.style.display='none'" alt=""/>` : ''}
      <div class="min-w-0 flex-1">
        <p class="text-xs font-semibold uppercase tracking-wide text-ande">Añadido al carrito</p>
        <p class="truncate text-sm font-medium text-ink">${cant} × ${nombre}</p>
        <p class="text-xs text-gold">${fmt(precio * cant)}</p>
      </div>
      <div class="flex shrink-0 flex-col items-end gap-1.5">
        <a href="/carrito" class="rounded-full bg-ink px-3.5 py-1.5 text-xs font-semibold text-cream transition hover:bg-ink-3">Ver carrito</a>
        <button data-toast-close class="text-ink-soft/50 transition hover:text-bronce" aria-label="Cerrar">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      </div>`;

    el.querySelector('[data-toast-close]')?.addEventListener('click', () => dismiss(el));
    root.appendChild(el);
    while (root.children.length > 3) root.firstElementChild?.remove();

    if (timer) clearTimeout(timer);
    timer = window.setTimeout(() => dismiss(el), 4000);
  }) as EventListener);

  function dismiss(el: HTMLElement) {
    el.classList.remove('toast-in');
    el.classList.add('toast-out');
    el.addEventListener('animationend', () => el.remove(), { once: true });
  }
</script>