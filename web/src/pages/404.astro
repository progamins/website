---
import Layout from '../components/Layout.astro';
---
<Layout title="Página no encontrada">
  <section class="mx-auto flex min-h-[60vh] max-w-md flex-col items-center justify-center px-4 text-center">
    <p class="font-display text-8xl text-gold">404</p>
    <h1 class="mt-4 font-display text-2xl text-ink">Página no encontrada</h1>
    <p class="mt-2 text-ink-soft/70">La página que buscas no existe o ha sido movida.</p>
    <a href="/" class="mt-6 rounded-full bg-ink px-6 py-3 font-semibold text-cream hover:bg-ink-3">Volver al inicio</a>
  </section>
</Layout>