---
import AdminLayout from '../../../components/admin/AdminLayout.astro';
import CategoriaForm from '../../../components/admin/CategoriaForm.astro';
import { db, type Categoria } from '../../../lib/db';
const categorias = db.prepare('SELECT * FROM categorias ORDER BY id').all() as Categoria[];
---
<AdminLayout title="Categorías">
  <div class="grid gap-6 lg:grid-cols-3">
    <div class="h-fit rounded-2xl border border-white/10 bg-ink-2 p-6">
      <h2 class="font-display text-lg text-white">Nueva categoría</h2>
      <p class="mt-1 text-xs text-gray-500">Cada categoría tiene una imagen y un icono circular (usado en el menú del sitio).</p>
      <div class="mt-4">
        <CategoriaForm />
      </div>
    </div>

    <div class="overflow-hidden rounded-2xl border border-white/10 bg-ink-2 lg:col-span-2">
      <table class="w-full text-left text-sm">
        <thead class="border-b border-white/10 text-xs uppercase tracking-wider text-gray-400">
          <tr><th class="px-4 py-3">Categoría</th><th class="px-4 py-3">Descripción</th><th class="px-4 py-3">Estado</th><th class="px-4 py-3 text-right">Acciones</th></tr>
        </thead>
        <tbody class="divide-y divide-white/5">
          {categorias.map((c) => (
            <tr class="hover:bg-white/5">
              <td class="px-4 py-3">
                <div class="flex items-center gap-3">
                  {(c.icono ?? c.imagen) && <img src={c.icono ?? c.imagen} class="h-9 w-9 rounded-full object-cover" onerror="this.style.visibility='hidden'" alt="" />}
                  <span class="font-medium text-white">{c.nombre}</span>
                </div>
              </td>
              <td class="max-w-[16rem] px-4 py-3 text-gray-400"><span class="line-clamp-1">{c.descripcion ?? '—'}</span></td>
              <td class="px-4 py-3"><span class:list={["rounded px-2 py-0.5 text-xs", c.activa ? "bg-green-500/20 text-green-400" : "bg-gray-500/20 text-gray-400"]}>{c.activa ? 'Activa' : 'Inactiva'}</span></td>
              <td class="px-4 py-3">
                <div class="flex justify-end gap-2">
                  <a href={`/admin/categorias/editar/${c.id}`} class="rounded-full border border-white/15 px-3 py-1.5 text-xs text-gray-300 hover:border-gold hover:text-gold">Editar</a>
                  <form action="/admin/categorias/toggle" method="post"><input type="hidden" name="id" value={c.id} /><button class="rounded-full border border-white/15 px-3 py-1.5 text-xs text-gray-300 hover:border-blue-400 hover:text-blue-400">{c.activa ? 'Desactivar' : 'Activar'}</button></form>
                  <form action="/admin/categorias/eliminar" method="post" onsubmit="return confirm('¿Eliminar esta categoría?')"><input type="hidden" name="id" value={c.id} /><button class="rounded-full border border-white/15 px-3 py-1.5 text-xs text-gray-300 hover:border-red-400 hover:text-red-400">Eliminar</button></form>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</AdminLayout>