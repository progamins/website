---
import AdminLayout from '../../../components/admin/AdminLayout.astro';
import { getLogo, getBanners } from '../../../lib/db';
const logo = getLogo();
const banners = getBanners();
const ok = Astro.url.searchParams.get('ok');
const tipos = [
  { v: 'video', l: 'Vídeo' },
  { v: 'imagen', l: 'Imagen' },
  { v: 'color', l: 'Color liso' },
];
const tipoLabel = (t: string) => tipos.find((x) => x.v === t)?.l ?? t;
---
<AdminLayout title="Configuración del sitio">
  {ok && <p class="mb-4 rounded-xl border border-green-500/40 bg-green-500/10 px-4 py-3 text-sm text-green-400">Cambios guardados correctamente ✓</p>}

  <form action="/admin/configuracion/guardar" method="post" enctype="multipart/form-data" class="grid gap-6 lg:grid-cols-2">
    <!-- LOGO -->
    <section class="h-fit rounded-2xl border border-white/10 bg-ink-2 p-6">
      <div class="flex items-center gap-3">
        <span class="flex h-9 w-9 items-center justify-center rounded-full bg-gold/20 font-display text-gold">1</span>
        <h2 class="font-display text-lg text-white">Logo de la tienda</h2>
      </div>
      <p class="mt-2 text-sm text-gray-400">Se muestra en la barra de navegación y el pie de página.</p>

      <div class="mt-5 flex items-center gap-4 rounded-xl border border-white/10 bg-ink p-4">
        {logo ? (
          <img src={logo} alt="Logo actual" class="h-12 w-auto max-w-[12rem] object-contain" />
        ) : (
          <div class="flex h-12 w-12 items-center justify-center rounded-full bg-gradient-to-br from-gold-light to-gold-dark font-display text-2xl font-bold text-white">C</div>
        )}
        <div>
          <p class="text-xs text-gray-500">Logo actual</p>
          <p class="text-sm text-gray-300">{logo ? 'Imagen personalizada' : 'Monograma por defecto'}</p>
        </div>
      </div>

      <label class="mt-4 block text-sm text-gray-400">Nuevo logo</label>
      <input name="logo_archivo" type="file" accept="image/*" class="mt-1 block w-full text-sm text-gray-400 file:mr-3 file:rounded-full file:border-0 file:bg-gold file:px-4 file:py-2 file:text-xs file:font-semibold file:text-ink" />

      <label class="mt-3 flex items-center gap-2 text-sm text-gray-300">
        <input name="quitar_logo" type="checkbox" class="h-4 w-4 accent-gold" /> Volver al monograma por defecto
      </label>

      <div class="mt-4 rounded-xl border border-gold/30 bg-gold/5 p-4 text-xs leading-relaxed text-gray-300">
        <p class="mb-1 font-semibold text-gold-light">Recomendaciones del logo</p>
        <ul class="list-disc space-y-1 pl-4">
          <li>Formato: <span class="text-gray-200">PNG con fondo transparente</span> (o SVG).</li>
          <li>Tamaño óptimo: <span class="text-gray-200">512 × 512 px</span> (mínimo 256 × 256).</li>
          <li>Peso máximo recomendado: <span class="text-gray-200">1 MB</span>.</li>
          <li>El logo se muestra en la barra superior y el pie de página; deja algo de espacio alrededor para que no se recorte.</li>
        </ul>
      </div>
    </section>

    <!-- BANNERS DE PORTADA (carrusel) -->
    <section class="rounded-2xl border border-white/10 bg-ink-2 p-6 lg:col-span-2">
      <div class="flex items-center gap-3">
        <span class="flex h-9 w-9 items-center justify-center rounded-full bg-gold/20 font-display text-gold">2</span>
        <div>
          <h2 class="font-display text-lg text-white">Carrusel de banners</h2>
          <p class="text-xs text-gray-500">Se muestran a pantalla completa en la portada, rotando automáticamente cada 5 segundos.</p>
        </div>
      </div>

      <div class="mt-5 space-y-4" data-banner-list>
        {banners.map((b, i) => (
          <div class="rounded-xl border border-white/10 bg-ink p-4" data-banner-row>
            <div class="flex flex-wrap items-center gap-3">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-gold/15 text-xs font-semibold text-gold">{i + 1}</span>
              <input type="hidden" name="banner_id" value={b.fondo ?? ''} />
              <select name="banner_tipo" class="rounded-lg border border-white/15 bg-ink px-3 py-2 text-sm text-white outline-none focus:border-gold">
                {tipos.map((t) => <option value={t.v} selected={b.tipo === t.v}>{t.l}</option>)}
              </select>
              <input name="banner_url" value={b.fondo ?? ''} placeholder="URL del fondo (o usa la subida)" class="min-w-0 flex-1 rounded-lg border border-white/15 bg-white/5 px-3 py-2 text-sm text-white placeholder-gray-500 outline-none focus:border-gold" />
              <input name="banner_fondo" type="file" accept="image/*,video/*" class="w-full text-xs text-gray-400 file:mr-2 file:rounded-full file:border-0 file:bg-gold file:px-3 file:py-1.5 file:text-[11px] file:font-semibold file:text-ink sm:w-auto" />
              <input name="banner_enlace" value={b.enlace ?? ''} placeholder="Enlace (opcional) ej. /ofertas" class="min-w-0 flex-1 rounded-lg border border-white/15 bg-white/5 px-3 py-2 text-sm text-white placeholder-gray-500 outline-none focus:border-gold" />
              <label class="flex shrink-0 items-center gap-1.5 text-xs text-red-400">
                <input name="banner_quitar" type="checkbox" value={String(i)} class="h-4 w-4 accent-red-500" /> Quitar
              </label>
            </div>
            {b.fondo && <p class="mt-2 truncate text-[11px] text-gray-500">Actual: {b.fondo} · {tipoLabel(b.tipo)}</p>}
          </div>
        ))}
      </div>

      <button type="button" data-add-banner class="mt-4 rounded-full border border-gold/50 px-5 py-2 text-sm font-semibold text-gold transition hover:bg-gold/10">+ Añadir banner</button>

      <template data-banner-tpl>
        <div class="rounded-xl border border-white/10 bg-ink p-4" data-banner-row>
          <div class="flex flex-wrap items-center gap-3">
            <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-gold/15 text-xs font-semibold text-gold">+</span>
            <input type="hidden" name="banner_id" value="" />
            <select name="banner_tipo" class="rounded-lg border border-white/15 bg-ink px-3 py-2 text-sm text-white outline-none focus:border-gold">
              {tipos.map((t) => <option value={t.v}>{t.l}</option>)}
            </select>
            <input name="banner_url" placeholder="URL del fondo (o usa la subida)" class="min-w-0 flex-1 rounded-lg border border-white/15 bg-white/5 px-3 py-2 text-sm text-white placeholder-gray-500 outline-none focus:border-gold" />
            <input name="banner_fondo" type="file" accept="image/*,video/*" class="w-full text-xs text-gray-400 file:mr-2 file:rounded-full file:border-0 file:bg-gold file:px-3 file:py-1.5 file:text-[11px] file:font-semibold file:text-ink sm:w-auto" />
            <input name="banner_enlace" placeholder="Enlace (opcional) ej. /ofertas" class="min-w-0 flex-1 rounded-lg border border-white/15 bg-white/5 px-3 py-2 text-sm text-white placeholder-gray-500 outline-none focus:border-gold" />
            <label class="flex shrink-0 items-center gap-1.5 text-xs text-red-400">
              <input name="banner_quitar" type="checkbox" value="" class="h-4 w-4 accent-red-500" /> Quitar
            </label>
          </div>
        </div>
      </template>

      <div class="mt-5 rounded-xl border border-gold/30 bg-gold/5 p-4 text-xs leading-relaxed text-gray-300">
        <p class="mb-1 font-semibold text-gold-light">Guía de los banners</p>
        <ul class="list-disc space-y-1 pl-4">
          <li><span class="text-gray-200">Resolución óptima:</span> 1920 × 1080 px (16:9). La mínima aceptable es 1280 × 720.</li>
          <li><span class="text-gray-200">Vídeo:</span> MP4 o WebM, hasta <span class="text-gray-200">10 MB</span>. Imagen: JPG o PNG de alta calidad, hasta <span class="text-gray-200">2 MB</span>.</li>
          <li><span class="text-gray-200">Sin textos superpuestos:</span> el banner se muestra a pantalla completa, por lo que los textos o logos deben estar integrados en la propia imagen/vídeo.</li>
          <li><span class="text-gray-200">Móvil:</span> la parte central (vertical) es la más visible; coloca ahí el mensaje principal. En escritorio el banner se recorta a lo ancho (16:9).</li>
          <li><span class="text-gray-200">Enlace opcional:</span> si lo rellenas, el banner completo será clicable.</li>
        </ul>
      </div>
    </section>

    <div class="lg:col-span-2">
      <button class="w-full rounded-full bg-gold px-6 py-3 font-semibold text-ink transition hover:bg-gold-light">Guardar cambios</button>
    </div>
  </form>
</AdminLayout>

<script>
  const list = document.querySelector('[data-banner-list]');
  const tpl = document.querySelector('[data-banner-tpl]') as HTMLTemplateElement;
  document.querySelector('[data-add-banner]')?.addEventListener('click', () => {
    if (!list || !tpl) return;
    const row = tpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
    const numero = list.children.length + 1;
    row.querySelector('[data-banner-row] span')!.textContent = String(numero);
    list.appendChild(row);
  });
</script>