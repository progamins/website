---
import AdminLayout from '../../../components/admin/AdminLayout.astro';
import ColeccionForm from '../../../components/admin/ColeccionForm.astro';
import { db, type Coleccion } from '../../../lib/db';
const colecciones = db.prepare('SELECT * FROM colecciones ORDER BY id').all() as Coleccion[];
---
<AdminLayout title="Colecciones">
  <div class="grid gap-6 lg:grid-cols-3">
    <div class="h-fit rounded-2xl border border-white/10 bg-ink-2 p-6">
      <h2 class="font-display text-lg text-white">Nueva colección</h2>
      <p class="mt-1 text-xs text-gray-500">Sube la imagen que representará la colección en la tienda.</p>
      <div class="mt-4">
        <ColeccionForm />
      </div>
    </div>

    <div class="overflow-hidden rounded-2xl border border-white/10 bg-ink-2 lg:col-span-2">
      <table class="w-full text-left text-sm">
        <thead class="border-b border-white/10 text-xs uppercase tracking-wider text-gray-400">
          <tr><th class="px-4 py-3">Colección</th><th class="px-4 py-3">Estado</th><th class="px-4 py-3 text-right">Acciones</th></tr>
        </thead>
        <tbody class="divide-y divide-white/5">
          {colecciones.map((c) => (
            <tr class="hover:bg-white/5">
              <td class="px-4 py-3">
                <div class="flex items-center gap-3">
                  {c.imagen ? <img src={c.imagen} class="h-12 w-10 rounded-md object-cover" onerror="this.style.visibility='hidden'" alt="" /> : <span class="flex h-12 w-10 items-center justify-center rounded-md bg-white/5 text-xs text-gray-500">sin</span>}
                  <div class="min-w-0">
                    <p class="font-medium text-white">{c.nombre}</p>
                    {c.descripcion && <p class="line-clamp-1 text-xs text-gray-500">{c.descripcion}</p>}
                  </div>
                </div>
              </td>
              <td class="px-4 py-3"><span class:list={["rounded px-2 py-0.5 text-xs", c.activa ? "bg-green-500/20 text-green-400" : "bg-gray-500/20 text-gray-400"]}>{c.activa ? 'Activa' : 'Inactiva'}</span></td>
              <td class="px-4 py-3">
                <div class="flex justify-end gap-2">
                  <a href={`/admin/colecciones/editar/${c.id}`} class="rounded-full border border-white/15 px-3 py-1.5 text-xs text-gray-300 hover:border-gold hover:text-gold">Editar</a>
                  <form action="/admin/colecciones/toggle" method="post"><input type="hidden" name="id" value={c.id} /><button class="rounded-full border border-white/15 px-3 py-1.5 text-xs text-gray-300 hover:border-blue-400 hover:text-blue-400">{c.activa ? 'Desactivar' : 'Activar'}</button></form>
                  <form action="/admin/colecciones/eliminar" method="post" onsubmit="return confirm('¿Eliminar esta colección?')"><input type="hidden" name="id" value={c.id} /><button class="rounded-full border border-white/15 px-3 py-1.5 text-xs text-gray-300 hover:border-red-400 hover:text-red-400">Eliminar</button></form>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</AdminLayout>