---
import AdminLayout from '../../../components/admin/AdminLayout.astro';
import { db, type Coleccion } from '../../../lib/db';
const colecciones = db.prepare('SELECT * FROM colecciones ORDER BY id').all() as Coleccion[];
---
<AdminLayout title="Colecciones">
  <div class="grid gap-6 lg:grid-cols-3">
    <form action="/admin/colecciones/guardar" method="post" enctype="multipart/form-data" class="h-fit rounded-2xl border border-white/10 bg-ink-2 p-6">
      <h2 class="font-display text-lg text-white">Nueva colección</h2>
      <div class="mt-4 space-y-3">
        <input name="nombre" required placeholder="Nombre" class="w-full rounded-xl border border-white/15 bg-white/5 px-3 py-2.5 text-white placeholder-gray-500 outline-none focus:border-gold" />
        <textarea name="descripcion" rows="3" placeholder="Descripción" class="w-full rounded-xl border border-white/15 bg-white/5 px-3 py-2.5 text-white placeholder-gray-500 outline-none focus:border-gold"></textarea>
        <input name="imagen" type="file" accept="image/*" class="block w-full text-sm text-gray-400 file:mr-3 file:rounded-full file:border-0 file:bg-gold file:px-4 file:py-2 file:text-xs file:font-semibold file:text-ink" />
        <button class="w-full rounded-full bg-gold px-6 py-2.5 font-semibold text-ink hover:bg-gold-light">Crear</button>
      </div>
    </form>

    <div class="overflow-hidden rounded-2xl border border-white/10 bg-ink-2 lg:col-span-2">
      <table class="w-full text-left text-sm">
        <thead class="border-b border-white/10 text-xs uppercase tracking-wider text-gray-400">
          <tr><th class="px-4 py-3">Nombre</th><th class="px-4 py-3">Estado</th><th class="px-4 py-3 text-right">Acciones</th></tr>
        </thead>
        <tbody class="divide-y divide-white/5">
          {colecciones.map((c) => (
            <tr class="hover:bg-white/5">
              <td class="px-4 py-3">
                <div class="flex items-center gap-3">
                  {c.imagen && <img src={c.imagen} class="h-9 w-9 rounded-lg object-cover" onerror="this.style.visibility='hidden'" alt="" />}
                  <span class="font-medium text-white">{c.nombre}</span>
                </div>
              </td>
              <td class="px-4 py-3"><span class:list={["rounded px-2 py-0.5 text-xs", c.activa ? "bg-green-500/20 text-green-400" : "bg-gray-500/20 text-gray-400"]}>{c.activa ? 'Activa' : 'Inactiva'}</span></td>
              <td class="px-4 py-3">
                <div class="flex justify-end gap-2">
                  <form action="/admin/colecciones/toggle" method="post"><input type="hidden" name="id" value={c.id} /><button class="rounded-full border border-white/15 px-3 py-1.5 text-xs text-gray-300 hover:border-blue-400 hover:text-blue-400">{c.activa ? 'Desactivar' : 'Activar'}</button></form>
                  <form action="/admin/colecciones/eliminar" method="post" onsubmit="return confirm('¿Eliminar?')"><input type="hidden" name="id" value={c.id} /><button class="rounded-full border border-white/15 px-3 py-1.5 text-xs text-gray-300 hover:border-red-400 hover:text-red-400">Eliminar</button></form>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</AdminLayout>