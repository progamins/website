---
import AdminLayout from '../../components/admin/AdminLayout.astro';
import { getStats, getPedidosPorMes, getNotificacionesRecientes, formatEUR } from '../../lib/db';
import { getEstadisticasPago, formatEUR as fmtPago } from '../../lib/pagos';
const stats = getStats();
const pagoStats = getEstadisticasPago();
const porMes = getPedidosPorMes();
const notifs = getNotificacionesRecientes(6);
const meses = porMes.map((m) => m.mes);
const ventas = porMes.map((m) => m.total);
const cards = [
  { label: 'Productos', value: String(stats.productos), icon: 'M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4' },
  { label: 'Usuarios', value: String(stats.usuarios), icon: 'M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z' },
  { label: 'Pedidos', value: String(stats.pedidos), icon: 'M3 3h18l-1 17-8 2-8-2L3 3zm4 4h10M7 11h10' },
  { label: 'Ingresos netos', value: fmtPago(pagoStats.neto), icon: 'M12 8c-2.2 0-4 .9-4 2s1.8 2 4 2 4 .9 4 2-1.8 2-4 2m0-8c0-1.1 0-2 0-2m0 12c0-1.1 0-2 0-2' },
];
---
<AdminLayout title="Dashboard">
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {cards.map((c) => (
      <div class="rounded-2xl border border-white/10 bg-ink-2 p-5">
        <div class="flex items-center justify-between">
          <span class="text-sm text-gray-400">{c.label}</span>
          <svg class="h-5 w-5 text-gold" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d={c.icon}/></svg>
        </div>
        <p class="mt-2 font-display text-2xl text-white">{c.value}</p>
      </div>
    ))}
  </div>

  <div class="mt-6 grid gap-6 lg:grid-cols-3">
    <div class="rounded-2xl border border-white/10 bg-ink-2 p-5 lg:col-span-2">
      <h2 class="font-display text-lg text-white">Ventas por mes</h2>
      <div class="mt-4 h-64"><canvas data-chart></canvas></div>
      {meses.length === 0 && <p class="mt-4 text-sm text-gray-500">Sin datos de ventas aún.</p>}
    </div>

    <div class="space-y-4">
      <div class="rounded-2xl border border-white/10 bg-ink-2 p-5">
        <h2 class="mb-3 font-display text-lg text-white">Sin stock</h2>
        {stats.sinStock.length === 0 ? <p class="text-sm text-gray-500">Todo con stock ✓</p> : (
          <ul class="space-y-2">
            {stats.sinStock.map((p) => (
              <li class="flex items-center justify-between gap-2 text-sm"><span class="truncate text-gray-300">{p.nombre}</span><span class="shrink-0 rounded bg-red-500/20 px-2 py-0.5 text-xs text-red-400">agotado</span></li>
            ))}
          </ul>
        )}
      </div>
      <div class="rounded-2xl border border-white/10 bg-ink-2 p-5">
        <h2 class="mb-3 font-display text-lg text-white">Pendientes de moderación</h2>
        <p class="font-display text-3xl text-gold">{stats.pendientes}</p>
      </div>
    </div>
  </div>

  <div class="mt-6 rounded-2xl border border-white/10 bg-ink-2 p-5">
    <h2 class="font-display text-lg text-white">Notificaciones recientes</h2>
    <ul class="mt-3 space-y-2">
      {notifs.map((n) => (
        <li class="flex items-center gap-3 text-sm">
          <span class="h-2 w-2 shrink-0 rounded-full" class:list={[n.leida ? 'bg-gray-600' : 'bg-gold']}></span>
          <span class="flex-1 text-gray-300">{n.mensaje}</span>
          <span class="shrink-0 text-xs text-gray-500">{new Date(n.creado_en).toLocaleDateString('es-ES')}</span>
        </li>
      ))}
      {notifs.length === 0 && <li class="text-sm text-gray-500">Sin notificaciones.</li>}
    </ul>
  </div>
</AdminLayout>

<script is:inline define:vars={{ meses, ventas }}>
  if (window.Chart) {
    const canvas = document.querySelector('[data-chart]');
    if (canvas) {
      new Chart(canvas, {
        type: 'line',
        data: {
          labels: meses,
          datasets: [{
            label: 'Ventas (€)',
            data: ventas,
            borderColor: '#c8a255',
            backgroundColor: 'rgba(200,162,85,0.15)',
            fill: true,
            tension: 0.4,
            pointBackgroundColor: '#e2c078',
          }],
        },
        options: {
          responsive: true, maintainAspectRatio: false,
          plugins: { legend: { labels: { color: '#9ca3af' } } },
          scales: {
            x: { ticks: { color: '#6b7280' }, grid: { color: 'rgba(255,255,255,0.05)' } },
            y: { ticks: { color: '#6b7280' }, grid: { color: 'rgba(255,255,255,0.05)' } },
          },
        },
      });
    }
  }
</script>