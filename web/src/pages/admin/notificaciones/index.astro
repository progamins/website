---
import AdminLayout from '../../../components/admin/AdminLayout.astro';
import { getNotificacionesRecientes } from '../../../lib/db';
const notifs = getNotificacionesRecientes(50);
const iconos: Record<string, string> = { pedido: 'M3 3h18l-1 17-8 2-8-2L3 3zm4 4h10M7 11h10', moderacion: 'M9 12l2 2 4-4', contacto: 'M21 12a8 8 0 01-8 8H4l2-2a8 8 0 1115-6z', stock: 'M13 10V3L4 14h7v7l9-11h-7z', info: 'M13 16h-1v-4h-1m1-4h.01' };
---
<AdminLayout title="Notificaciones">
  <div class="mb-4 flex justify-end">
    <form action="/admin/notificaciones/marcar" method="post"><button class="rounded-full bg-gold px-5 py-2 text-sm font-semibold text-ink hover:bg-gold-light">Marcar todas como leídas</button></form>
  </div>
  <div class="space-y-3">
    {notifs.length === 0 && <p class="text-gray-500">Sin notificaciones.</p>}
    {notifs.map((n) => (
      <div class:list={["flex items-start gap-4 rounded-2xl border p-5", n.leida ? "border-white/10 bg-ink-2" : "border-gold/50 bg-ink-2"]}>
        <span class="mt-0.5 flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-gold/20 text-gold">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.6"><path stroke-linecap="round" stroke-linejoin="round" d={iconos[n.tipo] ?? iconos.info}/></svg>
        </span>
        <div class="min-w-0 flex-1">
          <p class="text-gray-200">{n.mensaje}</p>
          <p class="mt-1 text-xs text-gray-500">{new Date(n.creado_en).toLocaleString('es-ES')}</p>
        </div>
        {n.enlace && <a href={n.enlace} class="shrink-0 rounded-full border border-white/15 px-3 py-1.5 text-xs text-gold hover:bg-gold/10">Ver</a>}
      </div>
    ))}
  </div>
</AdminLayout>