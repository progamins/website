---
import AdminLayout from '../../../components/admin/AdminLayout.astro';
import { getValoracionesPendientes, addNotificacion } from '../../../lib/db';
const pendientes = getValoracionesPendientes();
---
<AdminLayout title="Moderación">
  {pendientes.length === 0 ? (
    <div class="rounded-2xl border border-white/10 bg-ink-2 p-8 text-center text-gray-400">
      No hay valoraciones pendientes de moderación ✓
    </div>
  ) : (
    <div class="space-y-4">
      {pendientes.map((v) => (
        <div class="rounded-2xl border border-white/10 bg-ink-2 p-5">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <div>
              <div class="flex items-center gap-3">
                <span class="font-medium text-white">{v.nombre ?? 'Anónimo'}</span>
                <span class="text-sm text-gold">{'★'.repeat(v.puntuacion)}</span>
                <span class="rounded bg-blue-500/20 px-2 py-0.5 text-xs text-blue-400">Producto: {v.producto_nombre}</span>
              </div>
              {v.comentario && <p class="mt-2 max-w-2xl text-sm text-gray-300">{v.comentario}</p>}
            </div>
            <div class="flex gap-2">
              <form action="/admin/moderacion/aprobar" method="post"><input type="hidden" name="id" value={v.id} /><button class="rounded-full bg-gold px-4 py-2 text-sm font-semibold text-ink hover:bg-gold-light">Aprobar</button></form>
              <form action="/admin/moderacion/rechazar" method="post"><input type="hidden" name="id" value={v.id} /><button class="rounded-full border border-white/15 px-4 py-2 text-sm text-gray-300 hover:border-red-400 hover:text-red-400">Rechazar</button></form>
            </div>
          </div>
        </div>
      ))}
    </div>
  )}
</AdminLayout>