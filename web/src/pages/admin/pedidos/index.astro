---
import AdminLayout from '../../../components/admin/AdminLayout.astro';
import { db, formatEUR } from '../../../lib/db';
import { getPagosDePedido, formatEUR as fmtPago } from '../../../lib/pagos';
const pedidos = db.prepare(`SELECT p.*, u.nombre AS cliente FROM pedidos p LEFT JOIN usuarios u ON u.id=p.usuario_id ORDER BY p.id DESC`).all() as any[];
const detalle = (id: number) => db.prepare(`SELECT pd.*, pr.nombre FROM pedido_detalles pd LEFT JOIN productos pr ON pr.id=pd.producto_id WHERE pd.pedido_id=?`).all(id) as any[];
const pagosDe = (id: number) => getPagosDePedido(id);
const estados = ['pendiente', 'procesando', 'enviado', 'entregado', 'cancelado'];
const color: Record<string, string> = { pendiente: 'text-yellow-400', procesando: 'text-blue-400', enviado: 'text-purple-400', entregado: 'text-green-400', cancelado: 'text-red-400' };
const pagoColor: Record<string, string> = { pagado: 'bg-green-500/15 text-green-400', pendiente: 'bg-yellow-500/15 text-yellow-400', parcial: 'bg-blue-500/15 text-blue-400', fallido: 'bg-red-500/15 text-red-400', reembolsado: 'bg-purple-500/15 text-purple-400' };
const pagoLabel: Record<string, string> = { pagado: 'Pagado', pendiente: 'Pago pendiente', parcial: 'Pago parcial', fallido: 'Pago fallido', reembolsado: 'Reembolsado' };
const pagoEstadoColor: Record<string, string> = { aprobado: 'text-green-400', pendiente: 'text-yellow-400', fallido: 'text-red-400', reembolsado: 'text-blue-400' };
const pagoEstadoLabel: Record<string, string> = { aprobado: 'Aprobado', pendiente: 'Pendiente', fallido: 'Fallido', reembolsado: 'Reembolsado' };
const gatewayLabel: Record<string, string> = { tarjeta: 'Tarjeta', paypal: 'PayPal', transferencia: 'Transferencia', manual: 'Manual' };
---
<AdminLayout title="Pedidos">
  <div class="space-y-4">
    {pedidos.length === 0 && <p class="text-gray-500">Sin pedidos.</p>}
    {pedidos.map((ped) => {
      const pagos = pagosDe(ped.id);
      return (
        <details id={`pedido-${ped.id}`} class="group rounded-2xl border border-white/10 bg-ink-2">
          <summary class="flex flex-wrap cursor-pointer items-center justify-between gap-3 p-5">
            <div>
              <span class="font-medium text-white">{ped.referencia}</span>
              <span class="ml-3 text-sm text-gray-400">{ped.cliente ?? 'Invitado'}</span>
            </div>
            <div class="flex items-center gap-4">
              <span class="font-display text-gold">{formatEUR(ped.total)}</span>
              <span class:list={["rounded-full px-2.5 py-0.5 text-xs font-medium", pagoColor[ped.pago_estado]]}>{pagoLabel[ped.pago_estado] ?? ped.pago_estado}</span>
              <span class:list={["text-sm font-medium capitalize", color[ped.estado]]}>{ped.estado}</span>
              <span class="text-xs text-gray-500">{new Date(ped.creado_en).toLocaleDateString('es-ES')}</span>
            </div>
          </summary>
          <div class="border-t border-white/10 p-5">
            <div class="mb-4 flex items-center gap-2">
              <form action="/admin/pedidos/estado" method="post" class="flex items-center gap-2">
                <input type="hidden" name="id" value={ped.id} />
                <label class="text-xs text-gray-500">Estado del envío:</label>
                <select name="estado" class:list={["rounded-lg border border-white/15 bg-ink px-2 py-1.5 text-xs capitalize outline-none focus:border-gold", color[ped.estado]]}>
                  {estados.map((e) => <option value={e} selected={e === ped.estado}>{e}</option>)}
                </select>
                <button class="rounded-full bg-gold px-3 py-1.5 text-xs font-semibold text-ink hover:bg-gold-light">Actualizar</button>
              </form>
              <a href="/admin/pagos" class="ml-auto rounded-full border border-white/15 px-3 py-1.5 text-xs text-gray-300 hover:border-gold hover:text-gold">Ver pagos</a>
            </div>

            <div class="grid gap-6 lg:grid-cols-2">
              <div>
                <p class="mb-2 text-xs uppercase tracking-wider text-gray-500">Artículos</p>
                <div class="space-y-1 text-sm text-gray-300">
                  {detalle(ped.id).map((d) => (
                    <div class="flex justify-between"><span>{d.cantidad} × {d.nombre}</span><span>{formatEUR(d.subtotal)}</span></div>
                  ))}
                  <div class="flex justify-between border-t border-white/10 pt-2 font-medium text-white"><span>Total</span><span>{formatEUR(ped.total)}</span></div>
                </div>
                {ped.ciudad_envio && <p class="mt-3 text-xs text-gray-500">Envío: {ped.nombre_envio}, {ped.ciudad_envio}, {ped.codigo_postal}</p>}
                {ped.notas && <p class="mt-1 text-xs text-gray-500">Notas: {ped.notas}</p>}
              </div>

              <div>
                <p class="mb-2 text-xs uppercase tracking-wider text-gray-500">Transacciones de pago</p>
                {pagos.length === 0 ? (
                  <p class="text-sm text-gray-500">Sin pagos registrados. <a href="/admin/pagos/registrar" class="text-gold hover:text-gold-light">Registrar pago</a></p>
                ) : (
                  <div class="space-y-2">
                    {pagos.map((p) => (
                      <div class="rounded-xl border border-white/10 bg-ink p-3 text-sm">
                        <div class="flex items-center justify-between">
                          <span class="font-medium text-white">{p.referencia}</span>
                          <span class:list={["text-xs", pagoEstadoColor[p.estado]]}>{pagoEstadoLabel[p.estado]}</span>
                        </div>
                        <div class="mt-1 flex items-center justify-between text-xs text-gray-400">
                          <span>{gatewayLabel[p.gateway] ?? p.gateway} · {p.tipo === 'reembolso' ? 'Reembolso' : 'Pago'}</span>
                          <span class="text-gray-300">{fmtPago(p.monto)}</span>
                        </div>
                        {p.transaccion_externa && <p class="mt-1 text-xs text-gray-500">Txn: {p.transaccion_externa}</p>}
                        {p.tarjeta_ultimos4 && <p class="text-xs text-gray-500">Tarjeta ····{p.tarjeta_ultimos4}</p>}
                      </div>
                    ))}
                  </div>
                )}
              </div>
            </div>
          </div>
        </details>
      );
    })}
  </div>
</AdminLayout>

<script>
  if (location.hash.startsWith('#pedido-')) {
    const el = document.getElementById(location.hash.slice(1));
    if (el && el.tagName === 'DETAILS') el.open = true;
  }
</script>